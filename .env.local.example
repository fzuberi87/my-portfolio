# 1. Go to https://www.notion.so/my-integrations and create an Internal Integration
# 2. Copy the "Internal Integration Secret" below
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Open your Notion database → Share → Invite your integration
# 4. Copy the database ID from the URL:
#    notion.so/YOUR_WORKSPACE/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required database properties:
#   Name         (title)        – project title
#   Slug         (rich_text)    – URL-friendly slug, e.g. "redesign-checkout"
#   Status       (select)       – "Published" | "Draft"
#   Description  (rich_text)    – one-line summary
#   Tags         (multi_select) – e.g. "Product Design", "UX Research"
#   Role         (rich_text)    – e.g. "Lead Designer"
#   Year         (number)       – e.g. 2024
#   Featured     (checkbox)     – marks a hero card
#   Cover        (url)          – optional external cover image URL
